{
  "schemaVersion": 1,
  "source": "https://docs.kie.ai/",
  "description": "Agent-readable summary of the focused KIE workflows implemented by this repository.",
  "workflows": [
    {
      "family": "upload",
      "models": [],
      "sync": true,
      "tools": ["kie_upload_file"],
      "notes": "Uploads a local file to KIE temporary storage and returns a downloadUrl."
    },
    {
      "family": "image",
      "models": ["nano-banana-pro", "gpt-image-2"],
      "sync": false,
      "tools": ["kie_generate_image"],
      "notes": "gpt-image-2 chooses text-to-image or image-to-image based on reference images."
    },
    {
      "family": "video",
      "models": ["grok", "veo3", "seedance"],
      "sync": false,
      "tools": ["kie_generate_video"],
      "notes": "grok and seedance map to Market routes; veo3 supports veo3, veo3_fast, and veo3_lite variants."
    },
    {
      "family": "chat",
      "models": [
        "claude-opus-4-7", "claude-opus-4-8", "claude-fable-5", "claude-sonnet-5", "claude-haiku-4-5", "claude-opus-4-5", "claude-opus-4-6", "claude-opus-5", "claude-sonnet-4-5", "claude-sonnet-4-6",
        "gpt-5-2", "gpt-5-4", "gpt-5-5", "gpt-5-6-luna", "gpt-6-astra", "gpt-5-6-terra", "gpt-5-6-sol", "gpt-codex", "gemini-3-pro"
      ],
      "sync": true,
      "tools": ["kie_chat_completion"],
      "notes": "Claude Messages, OpenAI Chat Completions, OpenAI Responses, and Gemini chat workflows with optional image inputs."
    },
    {
      "family": "suno",
      "models": ["suno-music", "suno-lyrics", "suno-sounds"],
      "sync": false,
      "tools": ["kie_suno_music", "kie_suno_lyrics", "kie_suno_sounds"],
      "notes": "Async audio workflows. Some live Suno flows may require callback URLs."
    },
    {
      "family": "async-jobs",
      "models": [
        "nano-banana-pro",
        "gpt-image-2-text-to-image",
        "gpt-image-2-image-to-image",
        "grok-imagine/text-to-video",
        "grok-imagine/image-to-video",
        "bytedance/seedance-2-fast",
        "bytedance/seedance-2",
        "bytedance/seedance-1.5-pro",
        "veo3",
        "veo3_fast",
        "veo3_lite",
        "suno-music",
        "suno-lyrics",
        "suno-sounds"
      ],
      "sync": true,
      "tools": ["kie_get_job_status", "kie_wait_for_job"],
      "notes": "Status routing is model-based. Prefer saved job records when available."
    }
  ]
}
